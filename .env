# Ambiente locale (usato da VS Code per il debug).
# Questo file non deve contenere riferimenti a variabili non definite (niente ${workspaceFolder}).
# Il docker compose non ha bisogno di questo file; evita warning.

# Esempi (decommenta solo ciò che ti serve in locale):
# DATABASE_URL=postgresql+psycopg://resolver:resolver@127.0.0.1:5433/streamresolver
# RESOLVERS_DIR=./resolvers
# DOMAINS_JSON=./resolvers/config/domains.json
# PYTHONUNBUFFERED=1
# PORT=8000
