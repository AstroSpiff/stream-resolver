{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "FastAPI (uvicorn): app.main:APP",
      "type": "python",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "app.main:APP",
        "--reload",
        "--host",
        "0.0.0.0",
        "--port",
        "8000"
      ],
      "env": {
        "APP_DIR": "${workspaceFolder}",
        "CONFIG_DIR": "${workspaceFolder}/config",
        "STATIC_DIR": "${workspaceFolder}/app/static"
      },
      "jinja": true,
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal"
    },
    {
      "name": "Python: file attivo",
      "type": "python",
      "request": "launch",
      "program": "${file}",
      "env": {
        "APP_DIR": "${workspaceFolder}",
        "CONFIG_DIR": "${workspaceFolder}/config",
        "STATIC_DIR": "${workspaceFolder}/app/static"
      },
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env"
    }
  ]
}
